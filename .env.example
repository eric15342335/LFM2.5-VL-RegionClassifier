# 4-vCPU / 8-GB CPU deployment defaults.
DEVICE=cpu
ENGINE=llama
MODEL_GGUF=LiquidAI/LFM2.5-VL-450M-GGUF:Q4_K_M
THREADS=4
CONCURRENCY=2
PREPROCESS_CONCURRENCY=2
REQUEST_TIMEOUT=300
RESAMPLE=bilinear
MAX_BYTES=15000000
MAX_IMAGE_PIXELS=25000000
IMAGE_SESSION_TTL=900
IMAGE_SESSION_CACHE_BYTES=268435456
MAX_IMAGE_SESSIONS=32

# Optional paths and overrides.
LLAMA_SERVER=llama-server
LLAMA_SERVER_EXTRA_ARGS=
VLM_URL=

# Only needed when a different origin calls the API.
CORS_ORIGINS=
